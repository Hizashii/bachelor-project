{
  "name": "@freight-desk/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env.local --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file-if-exists=../../.env.local --experimental-strip-types src/scripts/migrate.ts",
    "admin:create": "node --env-file-if-exists=../../.env.local --experimental-strip-types src/scripts/createAdmin.ts",
    "demo:seed": "node --env-file-if-exists=../../.env.local --experimental-strip-types src/scripts/seedDemo.ts",
    "check:setup": "node --env-file-if-exists=../../.env.local --experimental-strip-types src/scripts/preflight.ts",
    "start": "node --env-file-if-exists=../../.env.local --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@freight-desk/shared": "*",
    "@node-rs/argon2": "2.2.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5"
  }
}
