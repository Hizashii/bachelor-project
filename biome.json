{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!AGENTS.md",
      "!docs",
      "!**/*.md",
      "!**/dist",
      "!**/.astro",
      "!**/test-results",
      "!apps/api/data"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "tailwind": {
    "stylesheet": "apps/app/src/styles.css"
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineEnding": "lf"
  },
  "linter": { "enabled": true }
}
