# This file contains local development settings only. It has no usable credentials.
NODE_ENV=development
APP_ORIGIN=http://localhost:4173
API_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3000

# SharePoint access is deliberately disabled until the Microsoft 365 app
# registration and Sites.Selected permissions have been approved.
SHAREPOINT_MODE=disabled
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_SITE_ID=
# SHAREPOINT_DRIVE_ID=

# PostgreSQL is reserved for account, organisation and authorisation metadata.
# Freight files and normalized freight rows stay in SharePoint or in temporary
# processing storage. The migration can be applied when the database is ready.
# DATABASE_URL=postgresql://localhost:5432/freight_desk

# The limit applies before a file is handed to a SharePoint adapter.
MAX_UPLOAD_BYTES=52428800
