# Copy to .env.local for local work. In production set these as secrets in the host, never in git.
NODE_ENV=development
APP_ORIGIN=http://localhost:4173
API_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3000
VITE_API_ORIGIN=http://localhost:3000
# Set true behind a trusted HTTPS proxy so the real client address is used for rate limits.
TRUST_PROXY=false

# --- Accounts (PostgreSQL: users, companies, roles, sessions only) -------------
# Local: docker run -d --name freight-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=freight -p 5432:5432 postgres:16-alpine
DATABASE_URL=postgresql://postgres:dev@localhost:5432/freight
STORAGE_MODE=local
LOCAL_STORAGE_DIR=data/storage
# true in production (HTTPS only). Sessions last this many seconds (8 hours).
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800

# --- SharePoint: where all freight files and tariffs are saved -----------------
# disabled = no cloud access (local only). graph = real SharePoint; required in production.
# The app signs in to Microsoft with its own application credentials. Users never do.
SHAREPOINT_MODE=disabled
# SHAREPOINT_TENANT_ID=<directory (tenant) ID of the client's Microsoft 365>
# SHAREPOINT_SITE_ID=<SharePoint site ID>
# SHAREPOINT_DRIVE_ID=<document library (drive) ID>
# SHAREPOINT_ROOT_ITEM_ID=<ID of the folder the app may use inside that library>
# SHAREPOINT_CLIENT_ID=<application (client) ID of the storage app registration>
# SHAREPOINT_CLIENT_SECRET=<client secret VALUE of the storage app registration>
# STORAGE_CURSOR_SECRET=<random value of at least 16 characters>

# Largest upload accepted, in bytes (50 MB).
MAX_UPLOAD_BYTES=52428800

# File imports (optional, these are the defaults)
IMPORT_MAX_FILE_MB=100
IMPORT_MAX_ROWS=500000
IMPORT_MAX_COLUMNS=200
IMPORT_MAX_CONCURRENT_JOBS=2
IMPORT_MAX_ATTEMPTS=3
IMPORT_RETENTION_MINUTES=30
