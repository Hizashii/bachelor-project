# This file lists fake local settings and contains no usable credentials.
APP_ORIGIN=http://localhost:4173
API_ORIGIN=http://localhost:3000
AUTH_MODE=mock
COOKIE_SECURE=false
SESSION_SECRET=local-only-secret-change-this-value-to-at-least-32-characters
SESSION_TTL_SECONDS=28800

# Required only when AUTH_MODE=entra. Keep the client secret server-side.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4173/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:4173/login
ENTRA_SCOPES=openid profile email

# Optional trusted server-side directory records. Never send this from the browser.
# AUTHORIZED_USERS_JSON=
