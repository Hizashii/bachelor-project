# This file contains local development settings only. It has no usable credentials.
NODE_ENV=development
APP_ORIGIN=http://localhost:4173
API_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=3000

# SharePoint access is deliberately disabled until the Microsoft 365 app
# registration and Sites.Selected permissions have been approved.
SHAREPOINT_MODE=disabled
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_SITE_ID=
# SHAREPOINT_DRIVE_ID=

# PostgreSQL is reserved for account, organisation and authorisation metadata.
# Freight files and normalized freight rows stay in SharePoint or in temporary
# processing storage. The migration can be applied when the database is ready.
# DATABASE_URL=postgresql://localhost:5432/freight_desk

# The limit applies before a file is handed to a SharePoint adapter.
MAX_UPLOAD_BYTES=52428800

# Used when SHAREPOINT_MODE=graph. Use a client-credentials app with Sites.Selected.
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_ROOT_ITEM_ID=
# STORAGE_CURSOR_SECRET=

# File imports (all optional, these are the defaults)
IMPORT_MAX_FILE_MB=100
IMPORT_MAX_ROWS=500000
IMPORT_MAX_COLUMNS=200
IMPORT_MAX_CONCURRENT_JOBS=2
IMPORT_MAX_ATTEMPTS=3
IMPORT_RETENTION_MINUTES=30
VITE_API_ORIGIN=http://localhost:3000

AUTH_MODE=mock
COOKIE_SECURE=false
SESSION_SECRET=local-only-secret-change-this-value-to-at-least-32-characters
SESSION_TTL_SECONDS=28800

# Required only when AUTH_MODE=entra. Keep the client secret server-side.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4173/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:4173/login
ENTRA_SCOPES=openid profile email

# Optional trusted server-side directory records. Never send this from the browser.
# AUTHORIZED_USERS_JSON=
