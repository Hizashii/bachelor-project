{
  "name": "freight-desk",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @freight-desk/web --filter @freight-desk/api dev",
    "dev:web": "pnpm --filter @freight-desk/web dev",
    "dev:api": "pnpm --filter @freight-desk/api dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "secrets": "node scripts/run-gitleaks.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "clean": "node -e \"for (const path of ['dist','coverage']) require('node:fs').rmSync(path,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.2.2",
    "vitest": "4.0.14"
  }
}
